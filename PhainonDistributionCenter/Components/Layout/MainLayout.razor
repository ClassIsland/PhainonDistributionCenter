@inherits LayoutComponentBase
@inject IHostEnvironment Env

<FluentLayout>
    <FluentHeader>
        PhainonDistributionCenter
    </FluentHeader>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu/>
        <FluentBodyContent Class="body-content">
            <div class="content">
                <FluentMessageBarProvider @rendermode="InteractiveServer" Section="@App.MESSAGES_TOP"/>
                @Body
                <FluentDialogProvider @rendermode="InteractiveServer"/>
            </div>
        </FluentBodyContent>
    </FluentStack>
    <FluentFooter>
        <span style="margin: 0 0 0 4px;">刻法勒永志不忘。</span>
        <FluentSpacer/>
        <span style="font-weight: bold">@(Env.EnvironmentName)</span>
    </FluentFooter>
    <FluentToastProvider MaxToastCount="10" @rendermode="InteractiveServer"/>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
