@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<div class="navmenu">
    <AuthorizeView>
        <Authorized>
            <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
            <label for="navmenu-toggle" class="navmenu-icon"><FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Fill" /></label>
            <nav class="sitenav" aria-labelledby="main-menu">
                <FluentNavMenu Id="main-menu" Collapsible="true" Width="250" Title="Navigation menu" @bind-Expanded="expanded" CustomToggle="true">
                    <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())" IconColor="Color.Accent">主页</FluentNavLink>
                    <FluentNavLink Href="Versions" Icon="@(new Icons.Regular.Size20.Apps())" IconColor="Color.Accent">大版本</FluentNavLink>
                    <FluentNavLink Href="Distributions" Icon="@(new Icons.Regular.Size20.Tag())" IconColor="Color.Accent">发行版</FluentNavLink>
                    <FluentNavLink Href="DistributionChannels" Icon="@(new Icons.Regular.Size20.Channel())" IconColor="Color.Accent">发行通道</FluentNavLink>
                    <FluentNavLink Href="PublicKey" Icon="@(new Icons.Regular.Size20.Key())" IconColor="Color.Accent">GPG 公钥</FluentNavLink>
                    <FluentNavLink Href="AccessTokens" Icon="@(new Icons.Regular.Size20.LockClosed())" IconColor="Color.Accent">访问令牌</FluentNavLink>
                </FluentNavMenu>
            </nav>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private bool expanded = true;
}
