@inject MainDbContext DbContext;
@inject IDialogService DialogService;
@inject ILogger<VersionsPage> Logger;
@inject IToastService ToastService;

@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.IsOrgMemberPolicyName)]

@page "/Distributions"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PhainonDistributionCenter.Entities
@using PhainonDistributionCenter.Security

<PageTitle>发行版</PageTitle>
<h2>发行版</h2>

<p>管理应用的各个发行版。</p>

<FluentButton Appearance="Appearance.Accent"
              @onclick="ButtonAddItemOnClick">
    添加
</FluentButton>

<div class="content">
    
    <FluentPaginator State="@paginationState" />
    <FluentDataGrid Items="@DbContext.DistributionInfos.Include(x => x.VersionInfo).Select(x => x)"
                    Pagination="@paginationState" @ref="@dataGridRef">
        <TemplateColumn Sortable="true" Title="发行版">
            <a href="Distributions/@(context.Id)">@(context.Version)</a>
        </TemplateColumn>
        <PropertyColumn Property="@(p => p.VersionInfo.Version)" Sortable="true" Title="大版本" Width="*"/>
        <PropertyColumn Property="@(p => p.CreatedTime)" Format="yyyy-MM-dd HH:mm" Sortable="true" Title="创建时间"
                        IsDefaultSortColumn InitialSortDirection="SortDirection.Descending"/>
        <PropertyColumn Property="@(p => p.UpdatedTime)" Format="yyyy-MM-dd HH:mm" Sortable="true" Title="修改时间"/>
        <TemplateColumn Title="操作">
            <FluentButton @onclick="@(_ => DeleteItem(context))">删除</FluentButton>
            <FluentButton @onclick="@(_ => BeginEditItem(context))">编辑</FluentButton>
        </TemplateColumn>
    </FluentDataGrid>
    <FluentPaginator State="@paginationState" />
    
</div>

<FluentDialog @bind-Hidden="@isEditingDialogHidden" >
    <h4>@(isCreating ? "新建" : "编辑")发行版</h4>
    <FluentStack Orientation="Orientation.Vertical" Style="margin-bottom: 2em">
        <FluentTextField Label="发行版" @bind-Value="editingInfo.Version" Required Style="width: 100%"/>
        <FluentCombobox TOption="VersionInfo" Items="@DbContext.VersionInfos" @bind-Value="@selectedVersionGuid"
                        OptionText="@(x => x.Version)"
                        OptionValue="@(x => x.Id.ToString())"
                        Label="大版本"
                        Style="width: 100%"/>
        
    </FluentStack>
    <FluentButton Appearance="Appearance.Accent" Autofocus="true" @onclick="ButtonEditingDialogSaveOnClick"
                  Loading="@isLoading">保存</FluentButton>
    <FluentButton @onclick="ButtonEditingDialogCancelOnClick">取消</FluentButton>
        
</FluentDialog>

<style scoped>
    
</style>

@code {
    private FluentDataGrid<DistributionInfo> dataGridRef;
    
    private bool isEditingDialogHidden = true;

    private bool isCreating = false;
    
    private int pageIndex = 0;

    private DistributionInfo editingInfo = new();

    private bool isLoading = false;

    private string? selectedVersionGuid;

    private PaginationState paginationState = new()
    {
        ItemsPerPage = 25
    };

    private void ButtonAddItemOnClick()
    {
        editingInfo = new DistributionInfo();
        isCreating = true;
        isEditingDialogHidden = false;
    }

    private void BeginEditItem(DistributionInfo item)
    {
        editingInfo = item;
        selectedVersionGuid = editingInfo.VersionInfoId.ToString();
        isCreating = false;
        isEditingDialogHidden = false;
    }

    private async Task DeleteItem(DistributionInfo item)
    {
        var reference = await DialogService.ShowConfirmationAsync($"确定要删除发行版 {item.Version} 吗？此操作无法撤销！");
        if ((await reference.Result).Cancelled)
        {
            return;
        }

        try
        {
            DbContext.DistributionInfos.Remove(item);
            await DbContext.SaveChangesAsync();
            await dataGridRef.RefreshDataAsync();
            ToastService.ShowSuccess($"已删除发行版 {item.Version}");
        }
        catch (Exception e)
        {
            ToastService.ShowError($"删除发行版 {item.Version} 时发生内部错误");
        }
    }
    
    private async Task ButtonEditingDialogSaveOnClick()
    {
        if (selectedVersionGuid == null)
        {
            ToastService.ShowError("请完整填写字段。");
            return;
        }
        isLoading = true;
        try
        {
            editingInfo.VersionInfoId = Guid.Parse(selectedVersionGuid);
            editingInfo.VersionInfo = (await DbContext.VersionInfos.FindAsync(editingInfo.VersionInfoId))!;
                
            if (isCreating)
            {
                await DbContext.DistributionInfos.AddAsync(editingInfo);
            }

            editingInfo.UpdatedTime = DateTimeOffset.UtcNow;
            await DbContext.SaveChangesAsync();
            await dataGridRef.RefreshDataAsync();
            ToastService.ShowSuccess($"已保存发行版 {editingInfo.Version}");

        }
        catch (Exception e)
        {
            Logger.LogError(e, "保存发行版 {EditingInfoVersion} 时发生内部错误", editingInfo.Version);
            ToastService.ShowError($"保存发行版 {editingInfo.Version} 时发生内部错误");
        }
        finally
        {
            isLoading = false;
            isEditingDialogHidden = true;
        }
    }

    private void ButtonEditingDialogCancelOnClick()
    {
        isEditingDialogHidden = true;
    }

}