@page "/{*route:nonfile}"
@using System.Diagnostics

@inject NavigationManager NavigationManager

<PageTitle>404</PageTitle>

<div class="content-center text-center flex flex-col items-center">
    <img src="/白厄_掉线.png"
         width="72" height="72"
         alt="白厄_掉线"/>
    <h1>404</h1>
    <p>找不到请求的页面，请检查链接是否有效，或您是否具有相应的访问权限。</p>
    <FluentAnchor Appearance="Appearance.Accent" Href="/">返回首页</FluentAnchor>
    <p style="font-size: 13px; margin-top: 2em">
        诊断信息：<br/>
        <b>RequestId: </b><code>@RequestId</code><br/>
        <b>Route: </b><code>/@Route</code>
    </p>
</div>

<style>
    
</style>


@code {
    [Parameter]
    public string? Route { get; set; }
    
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}