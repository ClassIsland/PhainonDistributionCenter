@page "/"
@using Microsoft.EntityFrameworkCore

@inject MainDbContext DbContext

<PageTitle>主页</PageTitle>

<h1>欢迎使用 PhainonDistributionCenter</h1>

<p>Count: @count</p>

@code {

    private int count = 0;

    protected override async Task OnInitializedAsync()
    {
        count = await DbContext.VersionInfos.CountAsync();
    }

}