@page "/Distributions/{id:guid}"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PhainonDistributionCenter.Entities
@using PhainonDistributionCenter.Extensions
@using PhainonDistributionCenter.Security
@inject NavigationManager NavigationManager;
@inject ILogger<DistributionDetailsPage> Logger;
@inject IDialogService DialogService;
@inject IToastService ToastService;
@inject IDbContextFactory<MainDbContext> DbContextFactory;
@attribute [Authorize(Policy = Policies.IsOrgMemberPolicyName)]

@rendermode InteractiveServer

@if (DistributionInfo != null && SelectedChannels != null && UiDbContext != null)
{
    <AuthorizeView>
        <Authorized Context="authContext">
            
            <PageTitle>发行版 @DistributionInfo?.Version</PageTitle>

            <h2>发行版 @DistributionInfo?.Version</h2>
            
            <p>@(DistributionInfo!.VersionInfo.Version) - @(DistributionInfo!.VersionInfo.Codename)</p>
            
            <FluentTabs Size="TabSize.Medium" Id="main-tab">
                <FluentTab Label="基本">
                    <div class="grid property-grid col-end-1 gap-4 p-2" style="">
                        <FluentCheckbox Label="已激活" @bind-Value="DistributionInfo.IsEnabled"
                                        Class="col-span-2" Disabled="!authContext.User.CanWrite()"/>
                        <p class="fluent-input-label text-start items-end">版本号</p>
                        <div class="flex items-end">
                            <FluentNumberField @bind-Value="DistributionInfo.VersionMajor" Disabled="!authContext.User.CanWrite()"/>.
                            <FluentNumberField @bind-Value="DistributionInfo.VersionMinor" Disabled="!authContext.User.CanWrite()"/>.
                            <FluentNumberField @bind-Value="DistributionInfo.VersionBuild" Disabled="!authContext.User.CanWrite()"/>.
                            <FluentNumberField @bind-Value="DistributionInfo.VersionRevision" Disabled="!authContext.User.CanWrite()"/>
                        </div>
                        <FluentTextField Label="友好版本名称" @bind-Value="DistributionInfo.FriendlyVersion" Disabled="!authContext.User.CanWrite()"/>
                        <FluentTextField Label="友好版本名称（短）" @bind-Value="DistributionInfo.FriendlyVersionShort" Disabled="!authContext.User.CanWrite()"/>
                        <p class="fluent-input-label text-start items-end">升级所需最低版本号</p>
                        <div class="flex items-end">
                            <FluentNumberField @bind-Value="DistributionInfo.MinVersionMajor" Disabled="!authContext.User.CanWrite()"/>.
                            <FluentNumberField @bind-Value="DistributionInfo.MinVersionMinor" Disabled="!authContext.User.CanWrite()"/>.
                            <FluentNumberField @bind-Value="DistributionInfo.MinVersionBuild" Disabled="!authContext.User.CanWrite()"/>.
                            <FluentNumberField @bind-Value="DistributionInfo.MinVersionRevision" Disabled="!authContext.User.CanWrite()"/>
                        </div>
                        
                        @if (authContext.User.CanWrite())
                        {
                            <div class="col-span-2 flex">
                                <FluentButton
                                    Loading="isLoading"
                                    Class="self-start"
                                    Appearance="Appearance.Accent"
                                    OnClick="SaveDataAsync">保存</FluentButton>
                            </div>
                        }
                    </div>
                </FluentTab>
                <FluentTab Label="子频道">
                    <div>
                        <FluentPaginator State="@paginationState"/>
                        <FluentDataGrid Items="@GetDbContext().DistributionSubChannels.Where(x => x.DistributionInfo == DistributionInfo)"
                                        @ref="dataGridRef"
                                        Pagination="@paginationState">

                            <PropertyColumn Property="@(p => p.Os)" Sortable="true" Title="操作系统"/>
                            <PropertyColumn Property="@(p => p.Arch)" Sortable="true" Title="架构"/>
                            <PropertyColumn Property="@(p => p.BuildType)" Sortable="true" Title="构建类型"/>
                            <PropertyColumn Property="@(p => p.Package)" Sortable="true" Title="打包类型"/>
                            <PropertyColumn Property="@(p => p.CreatedTime)" Format="yyyy-MM-dd HH:mm" Sortable="true" Title="创建时间"
                                            IsDefaultSortColumn InitialSortDirection="SortDirection.Descending"/>
                            <PropertyColumn Property="@(p => p.UpdatedTime)" Format="yyyy-MM-dd HH:mm" Sortable="true" Title="修改时间"/>
                            @if (authContext.User.CanWrite())
                            {
                                <TemplateColumn Title="操作">
                                    <FluentButton @onclick="@(_ => DeleteItem(context))">删除</FluentButton>
                                </TemplateColumn>
                            }
                        </FluentDataGrid>
                        <FluentPaginator State="@paginationState"/>
                    </div>
                </FluentTab>
                <FluentTab Label="发行日志">
                    <div class="flex flex-col gap-4" style="height: 100%">
                        <div class="grow">
                            <FluentTextArea Id="changelog-editor" @bind-Value="DistributionInfo.ChangeLog"
                                            ReadOnly="!authContext.User.CanWrite()"/>
                        </div>
                        @if (authContext.User.CanWrite())
                        {
                            <FluentButton
                                Loading="isLoading"
                                Class="self-start"
                                Appearance="Appearance.Accent"
                                OnClick="SaveDataAsync">保存</FluentButton>
                        }
                    </div>

                </FluentTab>
                <FluentTab Label="发行通道">
                    <div class="flex flex-col gap-4" style="height: 100%">
                        <div class="grow">
                            <FluentPaginator State="@channelsPaginationState"/>
                            <FluentDataGrid Items="@UiDbContext.DistributionChannels" Pagination="@channelsPaginationState"
                                            TGridItem="DistributionChannel" ShowHover="true">
                                <SelectColumn TGridItem="DistributionChannel"
                                              SelectMode="@DataGridSelectMode.Multiple"
                                              SelectFromEntireRow="@true"
                                              Width="40px"
                                              SelectedItems="@SelectedChannels"
                                              SelectedItemsChanged="channels => { if (authContext.User.CanWrite()) SelectedChannels = channels as IList<DistributionChannel> ?? SelectedChannels; }"/>
                                <PropertyColumn Property="@(p => p.Name)" Sortable="true" Title="名称"/>
                                <PropertyColumn Property="@(p => p.Description)" Sortable="true" Title="描述"/>
                                <PropertyColumn Property="@(p => p.CreatedTime)" Format="yyyy-MM-dd HH:mm" Sortable="true" Title="创建时间"
                                                IsDefaultSortColumn InitialSortDirection="SortDirection.Descending"/>
                                <PropertyColumn Property="@(p => p.UpdatedTime)" Format="yyyy-MM-dd HH:mm" Sortable="true" Title="修改时间"/>
                            </FluentDataGrid>
                            <FluentPaginator State="@channelsPaginationState"/>
                        </div>
                        @if (authContext.User.CanWrite())
                        {
                            <FluentButton
                                Loading="isLoading"
                                Class="self-start"
                                Appearance="Appearance.Accent"

                                OnClick="SaveDataAsync">保存</FluentButton>
                        }
                    </div>
                </FluentTab>
            </FluentTabs>
        </Authorized>
    </AuthorizeView>
}
else if (IsNotFound)
{
    <NotFoundPage/>
}

<style>
#changelog-editor {
    height: 100%;
    width: 100%;
}

fluent-text-area::part(control){ 
    height:100%;
}

#main-tab {
    height: calc(100% - 80px);
}

fluent-tab-panel {
    height: 100%;
}

.property-grid{
    grid-template-columns: 20% 80%;
}

.property-grid > :nth-child(1n) {
    /*text-align: right;*/
}
</style>



@code {
    [Parameter] public Guid Id { get; set; }

    public DistributionInfo? DistributionInfo { get; set; }

    private bool IsNotFound { get; set; } = false;

    private PaginationState paginationState = new()
    {
        ItemsPerPage = 25
    };
    
    private PaginationState channelsPaginationState = new()
    {
        ItemsPerPage = 25
    };

    private FluentDataGrid<DistributionSubChannel> dataGridRef;

    private bool isEditingDialogHidden = true;

    private bool isCreating = false;

    private int pageIndex = 0;

    private DistributionSubChannel editingInfo = new();

    private bool isLoading = false;

    private string? selectedVersionGuid;

    private MainDbContext GetDbContext() => DbContextFactory.CreateDbContext();

    private MainDbContext? UiDbContext { get; set; }

    private IList<DistributionChannel> SelectedChannels { get; set; }

    protected override async Task OnInitializedAsync()
    {
        UiDbContext = await DbContextFactory.CreateDbContextAsync();
        var info = await UiDbContext.DistributionInfos
            .Include(x => x.VersionInfo)
            .Include(x => x.Channels)
            .FirstOrDefaultAsync(x => x.Id == Id);
        if (info == null)
        {
            IsNotFound = true;
            // NavigationManager.NavigateTo("/404", replace:true);
            return;
        }
        DistributionInfo = info;
        SelectedChannels = DistributionInfo.Channels;
    }

    private void ButtonAddItemOnClick()
    {
        editingInfo = new DistributionSubChannel();
        isCreating = true;
        DialogService.ShowPanelAsync<SubChannelEditDrawer>(editingInfo, new DialogParameters()
        {
            Title = "新建子频道",
            Width = "500px"
        });
    }

    private void BeginEditItem(DistributionSubChannel item)
    {
        editingInfo = item;
        isCreating = false;
        isEditingDialogHidden = false;
    }

    private async Task DeleteItem(DistributionSubChannel item)
    {
        var reference = await DialogService.ShowConfirmationAsync($"确定要删除子频道 {item} 吗？此操作无法撤销！");
        if ((await reference.Result).Cancelled || DistributionInfo == null)
        {
            return;
        }

        try
        {
            var dbContext = GetDbContext();
            dbContext.Entry(DistributionInfo).State = EntityState.Modified;
            DistributionInfo.SubChannels.Remove(item);
            dbContext.DistributionSubChannels.Remove(item);
            await dbContext.SaveChangesAsync();
            await dataGridRef.RefreshDataAsync();
            ToastService.ShowSuccess($"已删除子频道 {item}");
        }
        catch (Exception e)
        {
            Logger.LogError(e, "删除子频道 {} 时发生内部错误", item);
            ToastService.ShowError($"删除子频道 {item} 时发生内部错误");
        }
    }


    private async Task SaveDataAsync()
    {
        if (DistributionInfo == null)
        {
            return;
        }

        try
        {
            isLoading = true;
            var dbContext = UiDbContext;
            var selected = SelectedChannels.ToList();
            DistributionInfo.Channels.Clear();
            DistributionInfo.Version = new Version(DistributionInfo.VersionMajor,
                DistributionInfo.VersionMinor,
                DistributionInfo.VersionBuild,
                DistributionInfo.VersionRevision).ToString();
            await dbContext!.SaveChangesAsync();
            foreach (var channel in selected)
            {
                DistributionInfo.Channels.Add(channel);
            }
            await dbContext.SaveChangesAsync();
            ToastService.ShowSuccess($"保存成功。");
        }
        catch (Exception e)
        {
            Logger.LogError(e, "保存时发生错误");
            ToastService.ShowError("保存发行版信息时发生内部错误。");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdateChannelSelection((DistributionChannel Item, bool Selected) obj)
    {
        if (SelectedChannels == null)
        {
            return;
        }
        Logger.LogInformation("{} {} {}", obj.Selected, SelectedChannels.Count, obj.Item);
        if (!obj.Selected && !SelectedChannels.Contains(obj.Item))
        {
            SelectedChannels.Add(obj.Item);
        }
        else
        {
            SelectedChannels.Remove(obj.Item);
        }
    }

}
