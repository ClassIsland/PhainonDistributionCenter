@page "/PublicKey"
@using PhainonDistributionCenter.Entities

@inject MainDbContext DbContext;
@inject IDialogService DialogService;
@inject ILogger<VersionsPage> Logger;
@inject IToastService ToastService;

@rendermode InteractiveServer

<PageTitle>PublicKeyPage</PageTitle>
<h2>公钥</h2>


<p>管理应用的各个 GPG 公钥。</p>

<FluentButton Appearance="Appearance.Accent"
              @onclick="ButtonAddItemOnClick">
    添加
</FluentButton>

<div class="content">
    
    <FluentPaginator State="@paginationState" />
    <FluentDataGrid Items="@DbContext.PublicKeys" Pagination="@paginationState" @ref="@dataGridRef">
        <PropertyColumn Property="@(p => p.Name)" Sortable="true" Title="名称"/>
        <PropertyColumn Property="@(p => p.CreatedTime)" Format="yyyy-MM-dd HH:mm" Sortable="true" Title="创建时间"
                        IsDefaultSortColumn InitialSortDirection="SortDirection.Descending"/>
        <PropertyColumn Property="@(p => p.UpdatedTime)" Format="yyyy-MM-dd HH:mm" Sortable="true" Title="修改时间"/>
        <TemplateColumn Title="操作">
            <FluentButton @onclick="@(_ => DeleteItem(context))">删除</FluentButton>
            <FluentButton @onclick="@(_ => BeginEditItem(context))">编辑</FluentButton>
        </TemplateColumn>
    </FluentDataGrid>
    <FluentPaginator State="@paginationState" />
    
</div>

<FluentDialog @bind-Hidden="@isEditingDialogHidden" >
    <h4>@(isCreating ? "新建" : "编辑") GPG 公钥</h4>
    <FluentStack Orientation="Orientation.Vertical" Style="margin-bottom: 2em">
        <FluentTextField Label="名称" @bind-Value="editingInfo.Name" Required Style="width: 100%"/>
        <FluentTextArea Label="公钥内容" @bind-Value="editingInfo.PublicKey" Required Style="width: 100%"
                        Resize="TextAreaResize.Vertical"/>
    </FluentStack>
    <FluentButton Appearance="Appearance.Accent" Autofocus="true" @onclick="ButtonEditingDialogSaveOnClick"
                  Loading="@isLoading">保存</FluentButton>
    <FluentButton @onclick="ButtonEditingDialogCancelOnClick">取消</FluentButton>
        
</FluentDialog>

<style scoped>
    
</style>

@code {
    private FluentDataGrid<GpgPublicKey> dataGridRef;
    
    private bool isEditingDialogHidden = true;

    private bool isCreating = false;
    
    private int pageIndex = 0;

    private GpgPublicKey editingInfo = new();

    private bool isLoading = false;

    private PaginationState paginationState = new()
    {
        ItemsPerPage = 25
    };

    private void ButtonAddItemOnClick()
    {
        editingInfo = new GpgPublicKey();
        isCreating = true;
        isEditingDialogHidden = false;
    }

    private void BeginEditItem(GpgPublicKey item)
    {
        editingInfo = item;
        isCreating = false;
        isEditingDialogHidden = false;
    }

    private async Task DeleteItem(GpgPublicKey item)
    {
        var reference = await DialogService.ShowConfirmationAsync($"确定要删除 GPG 公钥 {item.Name} 吗？此操作无法撤销！");
        if ((await reference.Result).Cancelled)
        {
            return;
        }

        try
        {
            DbContext.PublicKeys.Remove(item);
            await DbContext.SaveChangesAsync();
            await dataGridRef.RefreshDataAsync();
            ToastService.ShowSuccess($"已删除 GPG 公钥 {item.Name}");
        }
        catch (Exception e)
        {
            ToastService.ShowError($"删除 GPG 公钥 {item.Name} 时发生内部错误");
        }
    }
    
    private async Task ButtonEditingDialogSaveOnClick()
    {
        isLoading = true;
        try
        {
            if (isCreating)
            {
                await DbContext.PublicKeys.AddAsync(editingInfo);
            }

            editingInfo.UpdatedTime = DateTime.Now;
            await DbContext.SaveChangesAsync();
            await dataGridRef.RefreshDataAsync();
            ToastService.ShowSuccess($"已保存 GPG 公钥 {editingInfo.Name}");

        }
        catch (Exception e)
        {
            Logger.LogError(e, $"保存 GPG 公钥 {editingInfo.Name} 时发生内部错误");
            ToastService.ShowError($"保存 GPG 公钥 {editingInfo.Name} 时发生内部错误");
        }
        finally
        {
            isLoading = false;
            isEditingDialogHidden = true;
        }
    }

    private void ButtonEditingDialogCancelOnClick()
    {
        isEditingDialogHidden = true;
    }

}