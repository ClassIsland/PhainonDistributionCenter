@page "/Versions"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using PhainonDistributionCenter.Components.Controls
@using PhainonDistributionCenter.Entities
@inject MainDbContext DbContext;
@inject IDialogService DialogService;
@inject ILogger<VersionsPage> Logger;
@inject IToastService ToastService;
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>大版本</PageTitle>

<h2>大版本</h2>

<p>管理应用的各个大版本。</p>

<FluentButton Appearance="Appearance.Accent"
              @onclick="ButtonAddItemOnClick">
    添加
</FluentButton>

<div class="content">
    
    <FluentPaginator State="@paginationState" />
    <FluentDataGrid Items="@DbContext.VersionInfos" Pagination="@paginationState" @ref="@dataGridRef">
        <PropertyColumn Property="@(p => p.Version)" Sortable="true" Title="版本名"/>
        <PropertyColumn Property="@(p => p.Codename)" Sortable="true" Title="版本代号" Width="*"/>
        <PropertyColumn Property="@(p => p.CreatedTime)" Format="yyyy-MM-dd HH:mm" Sortable="true" Title="创建时间"
                        IsDefaultSortColumn InitialSortDirection="SortDirection.Descending"/>
        <PropertyColumn Property="@(p => p.UpdatedTime)" Format="yyyy-MM-dd HH:mm" Sortable="true" Title="修改时间"/>
        <TemplateColumn Title="操作">
            <FluentButton @onclick="@(_ => DeleteItem(context))">删除</FluentButton>
            <FluentButton @onclick="@(_ => BeginEditItem(context))">编辑</FluentButton>
        </TemplateColumn>
    </FluentDataGrid>
    <FluentPaginator State="@paginationState" />
    
</div>

<FluentDialog @bind-Hidden="@isEditingDialogHidden" >
    <h4>@(isCreating ? "新建" : "编辑")大版本</h4>
    <FluentStack Orientation="Orientation.Vertical" Style="margin-bottom: 2em">
        <FluentTextField Label="版本名" @bind-Value="editingInfo.Version" Required Style="width: 100%"/>
        <FluentTextField Label="版本代号" @bind-Value="editingInfo.Codename" Required Style="width: 100%"/>
    </FluentStack>
    <FluentButton Appearance="Appearance.Accent" Autofocus="true" @onclick="ButtonEditingDialogSaveOnClick"
                  Loading="@isLoading">保存</FluentButton>
    <FluentButton @onclick="ButtonEditingDialogCancelOnClick">取消</FluentButton>
        
</FluentDialog>

<style scoped>
    
</style>

@code {
    private FluentDataGrid<VersionInfo> dataGridRef;
    
    private bool isEditingDialogHidden = true;

    private bool isCreating = false;
    
    private int pageIndex = 0;

    private VersionInfo editingInfo = new();

    private bool isLoading = false;

    private PaginationState paginationState = new()
    {
        ItemsPerPage = 25
    };

    private void ButtonAddItemOnClick()
    {
        editingInfo = new VersionInfo();
        isCreating = true;
        isEditingDialogHidden = false;
    }

    private void BeginEditItem(VersionInfo item)
    {
        editingInfo = item;
        isCreating = false;
        isEditingDialogHidden = false;
    }

    private async Task DeleteItem(VersionInfo item)
    {
        var reference = await DialogService.ShowConfirmationAsync($"确定要删除大版本 {item.Version} 吗？此操作无法撤销！");
        if ((await reference.Result).Cancelled)
        {
            return;
        }

        try
        {
            DbContext.VersionInfos.Remove(item);
            await DbContext.SaveChangesAsync();
            await dataGridRef.RefreshDataAsync();
            ToastService.ShowSuccess($"已删除大版本 {item.Version}");
        }
        catch (Exception e)
        {
            ToastService.ShowError($"删除大版本 {item.Version} 时发生内部错误");
        }
    }
    
    private async Task ButtonEditingDialogSaveOnClick()
    {
        isLoading = true;
        try
        {
            if (isCreating)
            {
                await DbContext.VersionInfos.AddAsync(editingInfo);
            }

            editingInfo.UpdatedTime = DateTimeOffset.UtcNow;
            await DbContext.SaveChangesAsync();
            await dataGridRef.RefreshDataAsync();
            ToastService.ShowSuccess($"已保存大版本 {editingInfo.Version}");

        }
        catch (Exception e)
        {
            Logger.LogError(e, $"保存大版本 {editingInfo.Version} 时发生内部错误");
            ToastService.ShowError($"保存大版本 {editingInfo.Version} 时发生内部错误");
        }
        finally
        {
            isLoading = false;
            isEditingDialogHidden = true;
        }
    }

    private void ButtonEditingDialogCancelOnClick()
    {
        isEditingDialogHidden = true;
    }

}